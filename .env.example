# Calendar linking only; npm run calendar:link loads .env. The voice agent does not.
# Prefer a downloaded Google OAuth Desktop app JSON stored outside Git:
GOOGLE_OAUTH_CLIENT_FILE=.mango-data/google-oauth-client.json
# Alternatively omit GOOGLE_OAUTH_CLIENT_FILE and set these:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Optional API key; this does not replace OAuth sign-in:
GOOGLE_API_KEY=
# Private local connection storage (ignored by Git by default):
MANGO_GOOGLE_DATA_DIR=.mango-data/google-calendar
